---
/**
 * LightfallBg — full-viewport WebGL background using ogl.
 * Ported from the React Bits "Lightfall" component (vanilla JS + Astro).
 * Position: fixed, z-index 0 — sits above the body background but below
 * any content given `position: relative; z-index >= 1`.
 */
interface Props {
  colors?: string[];
  backgroundColor?: string;
  speed?: number;
  streakCount?: number;
  streakWidth?: number;
  streakLength?: number;
  glow?: number;
  density?: number;
  twinkle?: number;
  zoom?: number;
  backgroundGlow?: number;
  opacity?: number;
  mouseInteraction?: boolean;
  mouseStrength?: number;
  mouseRadius?: number;
  mouseDampening?: number;
  mixBlendMode?: string;
  paused?: boolean;
  dpr?: number;
}

const {
  colors = ['#e10600', '#ff6b35', '#1e3a8a'],
  backgroundColor = '#06060e',
  speed = 0.3,
  streakCount = 4,
  streakWidth = 1,
  streakLength = 1,
  glow = 0.8,
  density = 0.5,
  twinkle = 0.5,
  zoom = 3,
  backgroundGlow = 0.3,
  opacity = 1,
  mouseInteraction = true,
  mouseStrength = 0.5,
  mouseRadius = 0.8,
  mouseDampening = 0.15,
  mixBlendMode,
  paused = false,
  dpr,
} = Astro.props;

const config = {
  colors,
  backgroundColor,
  speed,
  streakCount,
  streakWidth,
  streakLength,
  glow,
  density,
  twinkle,
  zoom,
  backgroundGlow,
  opacity,
  mouseInteraction,
  mouseStrength,
  mouseRadius,
  mouseDampening,
  paused,
  dpr,
};
---

<div
  id="lightfall-bg"
  data-lightfall-config={JSON.stringify(config)}
  style={`position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;${mixBlendMode ? `mix-blend-mode:${mixBlendMode};` : ''}`}
>
</div>

<script>
  import { Renderer, Program, Mesh, Triangle } from 'ogl';

  // ── Helpers ──────────────────────────────────────────────────────────────

  const MAX_COLORS = 8;

  function hexToRGB(hex: string): [number, number, number] {
    const c = hex.replace('#', '').padEnd(6, '0');
    return [
      parseInt(c.slice(0, 2), 16) / 255,
      parseInt(c.slice(2, 4), 16) / 255,
      parseInt(c.slice(4, 6), 16) / 255,
    ];
  }

  function prepColors(input: string[]) {
    const base = (input && input.length ? input : ['#A6C8FF', '#5227FF', '#FF9FFC']).slice(0, MAX_COLORS);
    const count = base.length;
    const arr: [number, number, number][] = [];
    for (let i = 0; i < MAX_COLORS; i++) arr.push(hexToRGB(base[Math.min(i, base.length - 1)]));
    const avg: [number, number, number] = [0, 0, 0];
    for (let i = 0; i < count; i++) {
      avg[0] += arr[i][0];
      avg[1] += arr[i][1];
      avg[2] += arr[i][2];
    }
    avg[0] /= count;
    avg[1] /= count;
    avg[2] /= count;
    return { arr, count, avg };
  }

  // ── Shaders ───────────────────────────────────────────────────────────────

  // GLSL ES 3.00 (WebGL2). Required because the fragment shader uses dFdx/dFdy,
  // which ANGLE does not expose to ESSL1 shaders even inside a WebGL2 context
  // (GL_OES_standard_derivatives reports as unsupported there).
  const vertex = `#version 300 es
in vec2 position;
in vec2 uv;
out vec2 vUv;
void main() {
  vUv = uv;
  gl_Position = vec4(position, 0.0, 1.0);
}
`;

  const fragment = `#version 300 es
precision highp float;

uniform vec3  iResolution;
uniform vec2  iMouse;
uniform float iTime;

uniform vec3  uColor0;
uniform vec3  uColor1;
uniform vec3  uColor2;
uniform vec3  uColor3;
uniform vec3  uColor4;
uniform vec3  uColor5;
uniform vec3  uColor6;
uniform vec3  uColor7;
uniform int   uColorCount;

uniform vec3  uBgColor;
uniform vec3  uMouseColor;
uniform float uSpeed;
uniform int   uStreakCount;
uniform float uStreakWidth;
uniform float uStreakLength;
uniform float uGlow;
uniform float uDensity;
uniform float uTwinkle;
uniform float uZoom;
uniform float uBgGlow;
uniform float uOpacity;
uniform float uMouseEnabled;
uniform float uMouseStrength;
uniform float uMouseRadius;

in vec2 vUv;
out vec4 fragColor;

vec3 palette(float h) {
  int count = uColorCount;
  if (count < 1) count = 1;
  int idx = int(floor(clamp(h, 0.0, 0.999999) * float(count)));
  if (idx <= 0) return uColor0;
  if (idx == 1) return uColor1;
  if (idx == 2) return uColor2;
  if (idx == 3) return uColor3;
  if (idx == 4) return uColor4;
  if (idx == 5) return uColor5;
  if (idx == 6) return uColor6;
  return uColor7;
}

vec3 tanhv(vec3 x) {
  vec3 e = exp(-2.0 * x);
  return (1.0 - e) / (1.0 + e);
}

vec2 sceneC(vec2 frag, vec2 r) {
  vec2 P = (frag + frag - r) / r.x;
  float z = 0.0;
  float d = 1e3;
  vec4 O = vec4(0.0);
  for (int k = 0; k < 39; k++) {
    if (d <= 1e-4) break;
    O = z * normalize(vec4(P, uZoom, 0.0)) - vec4(0.0, 4.0, 1.0, 0.0) / 4.5;
    d = 1.0 - sqrt(length(O * O));
    z += d;
  }
  return vec2(O.x, atan(O.z, O.y));
}

void mainImage(out vec4 o, vec2 C) {
  vec2 r = iResolution.xy;
  vec2 uv0 = (C + C - r) / r.x;
  float T = 0.1 * iTime * uSpeed + 9.0;
  float angRings = max(1.0, floor(6.28318530718 * max(uDensity, 0.05) + 0.5));
  vec2 Y = vec2(5e-3, 6.28318530718 / angRings);

  // sceneC is a 39-iteration raymarch. The original called it three times per
  // pixel purely to finite-difference its own screen-space derivatives, which
  // is exactly what dFdx/dFdy give for free from the 2x2 fragment quad.
  // .y is an atan angle, so each derivative still needs the 2*pi wrap fix
  // (a raw derivative across the +pi/-pi seam is a full turn, not a step).
  vec2 c0 = sceneC(C, r);
  vec2 dCx = dFdx(c0);
  vec2 dCy = dFdy(c0);
  dCx.y -= 6.28318530718 * floor(dCx.y / 6.28318530718 + 0.5);
  dCy.y -= 6.28318530718 * floor(dCy.y / 6.28318530718 + 0.5);
  vec2 fw = abs(dCx) + abs(dCy);
  C = c0;

  vec2 P = vec2(2.0, 1.0) * uv0 - (r / r.x) * vec2(0.0, 1.0);
  vec4 O = vec4(uBgColor * 90.0 * uBgGlow / (1e3 * dot(P, P) + 6.0), 0.0);

  float mGlow = 0.0;
  if (uMouseEnabled > 0.5) {
    vec2 mN = (iMouse + iMouse - r) / r.x;
    float md = length(uv0 - mN);
    mGlow = exp(-md * md / max(uMouseRadius * uMouseRadius, 1e-4)) * uMouseStrength;
    O.rgb += uMouseColor * mGlow * 0.25;
  }

  float zr = 5e-4 * uStreakWidth;
  vec2 rr = vec2(max(length(fw), 1e-5));
  float tail = 19.0 / max(uStreakLength, 0.05);

  for (int m = 0; m < 16; m++) {
    if (m >= uStreakCount) break;
    float jf = float(m) + 1.0;
    float ic = fract(sin(dot(vec2(jf, floor(C.x / Y.x + 0.5)), vec2(7.0, 11.0)) * 73.0));
    vec2 Pp = C - (T + T * ic) * vec2(0.0, 1.0);
    Pp -= floor(Pp / Y + 0.5) * Y;
    float h = fract(8663.0 * ic);
    vec3 col = palette(h);
    float weight = mix(1.5, 1.0 + sin(T + 7.0 * h + 4.0), uTwinkle);
    weight *= (1.0 + mGlow * 2.0);
    vec2 inner = vec2(length(max(Pp, vec2(-1.0, 0.0))), length(Pp) - zr) - zr;
    vec2 sm = vec2(1.0) - smoothstep(-rr, rr, inner);
    O.rgb += dot(sm, vec2(exp(tail * Pp.y), 3.0)) * col * weight;
    C.x += Y.x / 8.0;
  }

  vec3 colr = sqrt(tanhv(max(O.rgb * uGlow - vec3(0.04, 0.08, 0.02), 0.0)));
  o = vec4(colr, uOpacity);
}

void main() {
  vec4 color;
  mainImage(color, vUv * iResolution.xy);
  fragColor = color;
}
`;

  // ── Initialise ────────────────────────────────────────────────────────────

  interface LightfallConfig {
    colors: string[];
    backgroundColor: string;
    speed: number;
    streakCount: number;
    streakWidth: number;
    streakLength: number;
    glow: number;
    density: number;
    twinkle: number;
    zoom: number;
    backgroundGlow: number;
    opacity: number;
    mouseInteraction: boolean;
    mouseStrength: number;
    mouseRadius: number;
    mouseDampening: number;
    paused: boolean;
    dpr?: number;
  }

  function initLightfall(): (() => void) | null {
    const container = document.getElementById('lightfall-bg') as HTMLElement | null;
    if (!container) return null;

    const raw = container.dataset.lightfallConfig;
    if (!raw) return null;
    const cfg: LightfallConfig = JSON.parse(raw);

    // This is a soft, out-of-focus background: rendering it at 2x on a Retina
    // display quadruples the fragment count of a shader that is already the
    // most expensive thing on the page, for no visible gain. Cap at 1x.
    // `antialias` is MSAA on a fullscreen triangle — there are no geometry
    // edges to smooth, so it is pure cost; the shader antialiases the streaks
    // itself via smoothstep. No depth/stencil buffers are used either.
    const renderer = new Renderer({
      dpr: cfg.dpr ?? Math.min(typeof window !== 'undefined' ? window.devicePixelRatio || 1 : 1, 1),
      alpha: true,
      antialias: false,
      depth: false,
      stencil: false,
      powerPreference: 'low-power',
    });
    const gl = renderer.gl;
    // The shader is GLSL ES 3.00; ogl silently falls back to a WebGL1 context
    // when WebGL2 is missing, where it would fail to compile. Decorative
    // background — just skip it rather than spamming the console.
    if (!renderer.isWebgl2) return null;
    const canvas = gl.canvas as HTMLCanvasElement;
    // Absolute, not static: a canvas in normal flow contributes its height to the
    // page. If the container ever renders unstyled the canvas would push the whole
    // document down by a viewport — which is what a stale cached stylesheet did.
    canvas.style.position = 'absolute';
    canvas.style.inset = '0';
    canvas.style.width = '100%';
    canvas.style.height = '100%';
    canvas.style.display = 'block';
    container.appendChild(canvas);

    const { arr, count, avg } = prepColors(cfg.colors);

    const uniforms: Record<string, { value: unknown }> = {
      iResolution: { value: [gl.drawingBufferWidth, gl.drawingBufferHeight, 1] },
      iMouse:      { value: [0, 0] },
      iTime:       { value: 0 },
      uColor0:     { value: arr[0] },
      uColor1:     { value: arr[1] },
      uColor2:     { value: arr[2] },
      uColor3:     { value: arr[3] },
      uColor4:     { value: arr[4] },
      uColor5:     { value: arr[5] },
      uColor6:     { value: arr[6] },
      uColor7:     { value: arr[7] },
      uColorCount: { value: count },
      uBgColor:    { value: hexToRGB(cfg.backgroundColor) },
      uMouseColor: { value: avg },
      uSpeed:      { value: cfg.speed },
      uStreakCount:{ value: Math.max(1, Math.min(16, Math.round(cfg.streakCount))) },
      uStreakWidth: { value: cfg.streakWidth },
      uStreakLength:{ value: cfg.streakLength },
      uGlow:       { value: cfg.glow },
      uDensity:    { value: cfg.density },
      uTwinkle:    { value: cfg.twinkle },
      uZoom:       { value: cfg.zoom },
      uBgGlow:     { value: cfg.backgroundGlow },
      uOpacity:    { value: cfg.opacity },
      uMouseEnabled:{ value: cfg.mouseInteraction ? 1 : 0 },
      uMouseStrength:{ value: cfg.mouseStrength },
      uMouseRadius: { value: cfg.mouseRadius },
    };

    const program  = new Program(gl, { vertex, fragment, uniforms });
    const geometry = new Triangle(gl);
    const mesh     = new Mesh(gl, { geometry, program });

    // Resize handler
    const resize = () => {
      const rect = container.getBoundingClientRect();
      renderer.setSize(rect.width, rect.height);
      (uniforms.iResolution.value as number[])[0] = gl.drawingBufferWidth;
      (uniforms.iResolution.value as number[])[1] = gl.drawingBufferHeight;
    };
    resize();

    // Mouse — listen on window so pointer events still reach page UI elements
    let mouseTarget: [number, number] = [0, 0];

    const onPointerMove = (e: PointerEvent) => {
      const rect = container.getBoundingClientRect();
      const scale = renderer.dpr || 1;
      const x = (e.clientX - rect.left) * scale;
      const y = (rect.height - (e.clientY - rect.top)) * scale;
      mouseTarget = [x, y];
      if (cfg.mouseDampening <= 0) {
        (uniforms.iMouse.value as number[])[0] = x;
        (uniforms.iMouse.value as number[])[1] = y;
      }
    };
    if (cfg.mouseInteraction) {
      window.addEventListener('pointermove', onPointerMove);
    }

    // Animation loop. This is the single most expensive thing on the page, so
    // it only runs when it can actually be seen, and at half the display rate:
    // the motion is slow and ambient, 30fps is indistinguishable from 60.
    const FRAME_MS = 1000 / 30;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    let rafId = 0;
    let running = false;
    let onscreen = true;
    // Animation time is accumulated rather than taken from the rAF timestamp,
    // so pausing and resuming does not make the streaks jump forward.
    let clock = 0;
    let prevT = 0;
    let lastDraw = -Infinity;

    const draw = () => {
      uniforms.iTime.value = clock;
      try {
        renderer.render({ scene: mesh });
      } catch (err) {
        console.error('[LightfallBg]', err);
      }
    };

    const loop = (t: number) => {
      rafId = requestAnimationFrame(loop);
      if (t - lastDraw < FRAME_MS - 1) return;
      // Clamped so a stalled frame does not fast-forward the animation.
      const dt = Math.min((t - prevT) / 1000, 0.1);
      prevT = t;
      lastDraw = t;
      clock += dt;

      if (cfg.mouseDampening > 0) {
        const tau = Math.max(1e-4, cfg.mouseDampening);
        const factor = Math.min(1, 1 - Math.exp(-dt / tau));
        const cur = uniforms.iMouse.value as number[];
        cur[0] += (mouseTarget[0] - cur[0]) * factor;
        cur[1] += (mouseTarget[1] - cur[1]) * factor;
      }

      draw();
    };

    const start = () => {
      if (running) return;
      running = true;
      prevT = performance.now();
      lastDraw = -Infinity;
      rafId = requestAnimationFrame(loop);
    };
    const stop = () => {
      if (!running) return;
      running = false;
      cancelAnimationFrame(rafId);
    };
    // Nothing worth animating for a hidden tab, an off-screen or display:none
    // container, an explicit pause, or a reduced-motion preference — in every
    // one of those cases the last drawn frame simply stays on screen.
    const sync = () => {
      if (!cfg.paused && !document.hidden && onscreen && !reduceMotion.matches) start();
      else stop();
    };

    draw(); // one frame up front, so a paused/reduced-motion canvas is not blank

    // ResizeObserver can fire many times per frame during a drag; coalesce.
    let resizeRaf = 0;
    const ro = new ResizeObserver(() => {
      if (resizeRaf) return;
      resizeRaf = requestAnimationFrame(() => {
        resizeRaf = 0;
        resize();
        if (!running) draw();
      });
    });
    ro.observe(container);

    // The container is position:fixed so it is normally always on screen, but
    // this still covers display:none and any non-fixed use of the component.
    const io = new IntersectionObserver((entries) => {
      onscreen = entries.some((e) => e.isIntersecting);
      sync();
    });
    io.observe(container);

    document.addEventListener('visibilitychange', sync);
    reduceMotion.addEventListener('change', sync);
    sync();

    // Cleanup
    return () => {
      stop();
      cancelAnimationFrame(resizeRaf);
      if (cfg.mouseInteraction) window.removeEventListener('pointermove', onPointerMove);
      document.removeEventListener('visibilitychange', sync);
      reduceMotion.removeEventListener('change', sync);
      io.disconnect();
      ro.disconnect();
      if (canvas.parentElement === container) container.removeChild(canvas);
      const call = (obj: unknown, key: string) => {
        if (obj && typeof (obj as Record<string, unknown>)[key] === 'function') {
          ((obj as Record<string, unknown>)[key] as () => void).call(obj);
        }
      };
      call(program,  'remove');
      call(geometry, 'remove');
      call(mesh,     'remove');
      call(renderer, 'destroy');
    };
  }

  // ── Lifecycle (handles Astro view transitions) ────────────────────────────

  let cleanup = initLightfall();
  document.addEventListener('astro:before-swap', () => cleanup?.());
  document.addEventListener('astro:after-swap',  () => { cleanup = initLightfall(); });
</script>
