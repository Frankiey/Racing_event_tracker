---
import Layout from '../layouts/Layout.astro';
import SeriesBadge from '../components/SeriesBadge.astro';
import { getSeriesMeta } from '../lib/series';
import { countryFlag, isPlaceholderTime } from '../lib/time';
import { formatKioskRound } from '../lib/kiosk/state';
import { SESSION_ABBR } from '../lib/sessions';

import type { EventFeed } from '../lib/types';
import upcomingData from '../../data/gold/upcoming.json';
import calendarData from '../../data/gold/calendar.json';
import broadcastsData from '../../data/gold/broadcasts.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allEvents = (upcomingData as EventFeed).events;
const sorted = [...allEvents].sort((a, b) => a.dateStart.localeCompare(b.dateStart));

const now = new Date();
// No fallback to sorted[0]: that is a past event when the feed is stale/off-season, and would be
// shown as the hero with a dead countdown. null renders the empty state instead.
const nextEvent = sorted.find(e =>
  e.sessions.some((s) => !isPlaceholderTime(s.startTimeUTC) && new Date(s.startTimeUTC) > now)
) ?? null;

const heroSeriesMeta = nextEvent ? getSeriesMeta(nextEvent.seriesId) : null;
const heroColor = heroSeriesMeta?.color ?? '#71717a';
const heroFlag = nextEvent?.circuit?.countryCode ? countryFlag(nextEvent.circuit.countryCode) : '';
const heroSessions = nextEvent
  ? nextEvent.sessions.filter((s) => !isPlaceholderTime(s.startTimeUTC))
  : [];
// Season round totals per series come from the full calendar (upcoming.json only holds the
// events still to run, so counting it gives "Round 12 / 3"). Only this tiny map is embedded.
const roundTotals: Record<string, number> = {};
for (const e of (calendarData as EventFeed).events) roundTotals[e.seriesId] = (roundTotals[e.seriesId] ?? 0) + 1;

// Off-season hint for the empty state: first calendar event that hasn't finished yet at build time
// (the client only shows it if it's still ahead). Tiny object — the calendar itself is not embedded.
const todayIso = now.toISOString().slice(0, 10);
const nextCalendarEvent = [...(calendarData as EventFeed).events]
  .filter(e => e.dateEnd >= todayIso)
  .sort((a, b) => a.dateStart.localeCompare(b.dateStart))[0];
const nextCalendarHint = nextCalendarEvent
  ? { eventName: nextCalendarEvent.eventName, dateStart: nextCalendarEvent.dateStart, dateEnd: nextCalendarEvent.dateEnd }
  : null;

---

<Layout title="RaceTrack — Kiosk" bare={true}>
  <script id="kiosk-data" type="application/json" set:html={JSON.stringify(sorted)} is:inline />
  <script id="kiosk-round-totals" type="application/json" set:html={JSON.stringify(roundTotals)} is:inline />
  <script id="kiosk-next-calendar" type="application/json" set:html={JSON.stringify(nextCalendarHint)} is:inline />
  <script id="kiosk-generated" type="application/json" set:html={JSON.stringify((upcomingData as { generated?: string }).generated ?? null)} is:inline />
  <script id="kiosk-base" type="application/json" set:html={JSON.stringify(base)} is:inline />
  <script id="kiosk-broadcasts" type="application/json" set:html={JSON.stringify(broadcastsData)} is:inline />

  <!-- Scanline overlay -->
  <div class="kiosk-scanlines fixed inset-0 z-0 pointer-events-none" />

  <!-- Back button -->
  <a
    href={`${base}/`}
    id="kiosk-back"
    class="kiosk-chrome fixed top-4 left-4 z-50 flex items-center gap-1.5 px-3 py-2 rounded-xl border border-zinc-700/50 bg-zinc-900/80 backdrop-blur-md text-zinc-400 text-sm font-medium hover:text-zinc-200 hover:border-zinc-600/60 hover:bg-zinc-800/80 transition-all duration-200 group shadow-lg shadow-black/40"
  >
    <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
    </svg>
    Dashboard
  </a>

  <!-- Manual mode indicator -->
  <button
    id="kiosk-manual-badge"
    class="hidden fixed top-4 right-4 z-50 flex items-center gap-1.5 px-3 py-2 rounded-xl border border-amber-700/50 bg-amber-950/40 backdrop-blur-md text-amber-400 text-sm font-bold uppercase tracking-widest hover:bg-amber-950/60 transition-all duration-200 shadow-lg shadow-black/40"
    title="Click to resume auto mode"
  >
    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
    </svg>
    Manual · Resume Auto
  </button>

  <div
    id="kiosk-root"
    class="relative flex flex-col landscape:lg:flex-row h-dvh overflow-hidden bg-zinc-950 text-zinc-100 kiosk-mode-enter z-10"
  >
    <!-- ══ Hero ══ -->
    <section
      id="kiosk-hero"
      class="flex-1 min-h-0 flex flex-col justify-center p-5 sm:p-10 lg:p-14 xl:p-16 relative overflow-x-hidden overflow-y-auto kiosk-noscrollbar"
    >
      <!-- Animated radial glow bg -->
      <div
        id="kiosk-hero-bg"
        class="kiosk-bg-glow absolute inset-0 pointer-events-none"
        style={`background: radial-gradient(ellipse 90% 70% at 35% 55%, ${heroColor}12 0%, transparent 65%);`}
      />
      <!-- Secondary glow for depth: slow ambient drift, always on and deliberately subtle (jwt3.11) -->
      <div
        id="kiosk-hero-bg2"
        class="kiosk-bg-drift absolute inset-0 pointer-events-none"
        style={`background: radial-gradient(ellipse 50% 40% at 70% 20%, ${heroColor}08 0%, transparent 60%);`}
      />

      <!-- Empty state (off-season / nothing left to show); toggled by renderEmpty() -->
      <div id="kiosk-empty" hidden={nextEvent !== null} class="relative pl-5 my-auto" style="border-left: 3px solid #3f3f46;">
        <p class="text-sm uppercase tracking-[0.3em] text-zinc-400 mb-3">Off-season</p>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black leading-none tracking-tight text-zinc-300 mb-4">No upcoming events</h1>
        <p id="kiosk-empty-next" class="text-base text-zinc-400 font-medium"></p>
      </div>

      <div id="kiosk-hero-content" hidden={nextEvent === null} class="flex-1 min-h-0 flex flex-col justify-center">
      <!-- Live mode header -->
      <div id="kiosk-live-header" class="hidden mb-8 items-center gap-4">
        <!-- Ring + dot -->
        <div class="relative flex items-center justify-center w-5 h-5">
          <span class="kiosk-live-ring absolute inline-flex w-5 h-5 rounded-full" style={`background: ${heroColor}40;`}></span>
          <span class="kiosk-live-dot relative w-2.5 h-2.5 rounded-full" style={`background: ${heroColor};`}></span>
        </div>
        <span class="text-xl font-black uppercase tracking-[0.25em] text-zinc-100">Live Now</span>
      </div>

      <!-- Also-live chips -->
      <div id="kiosk-also-live" class="hidden mb-5 flex-wrap gap-2"></div>

      <!-- Hero card: event info -->
      <div
        id="kiosk-hero-card"
        class="relative mb-8 pl-5 pr-0"
        style={`border-left: 3px solid ${heroColor}70;`}
      >
        <!-- Series + round row -->
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <div id="kiosk-series-badge">
            <SeriesBadge seriesId={nextEvent?.seriesId ?? 'f1'} size="lg" />
          </div>
          <span
            id="kiosk-round-badge"
            class="text-sm font-mono tabular-nums px-2 py-0.5 rounded-md bg-zinc-900/80 border border-zinc-800 text-zinc-400"
          >
            {nextEvent ? formatKioskRound(nextEvent.round, roundTotals[nextEvent.seriesId]) : ''}
          </span>
          <span
            id="kiosk-weekend-badge"
            hidden
            class="text-sm font-black uppercase tracking-[0.2em] px-2.5 py-0.5 rounded-full text-zinc-100"
            style={`background: ${heroColor}40; border: 1px solid ${heroColor}80;`}
          >
            This Weekend
          </span>
        </div>

        <!-- Event name + flag -->
        <div class="flex items-start gap-5">
          <div class="flex-1 min-w-0">
            <h1
              id="kiosk-event-name"
              class="text-3xl sm:text-5xl lg:text-6xl font-black leading-none tracking-tight line-clamp-2 mb-3"
            >
              {nextEvent?.eventName ?? '—'}
            </h1>
            <!-- Live session progress -->
            <div id="kiosk-session-progress-wrap" class="hidden mb-3 h-1 max-w-md rounded-full bg-zinc-800/60 overflow-hidden">
              <div id="kiosk-session-progress-bar" class="h-full rounded-full" style={`width: 0%; background: ${heroColor};`} />
            </div>
            <p id="kiosk-circuit-name" class="text-base text-zinc-400 font-medium">
              {nextEvent?.circuit?.name}
              {nextEvent?.circuit?.city ? ` · ${nextEvent.circuit.city}` : ''}
            </p>
            <!-- Trivia: real circuit data only (length / lap record); rotates with the hero event -->
            <p id="kiosk-trivia" hidden class="mt-1 text-sm text-zinc-400 font-medium"></p>
            <!-- Live elapsed -->
            <p id="kiosk-live-elapsed" hidden class="mt-2 text-base font-medium text-zinc-200"></p>
            <!-- Broadcast info -->
            <p id="kiosk-broadcast-info" hidden class="mt-2 text-sm text-zinc-400 font-medium"></p>
          </div>
          <!-- Flag -->
          <div
            id="kiosk-flag"
            class="text-5xl sm:text-7xl lg:text-8xl leading-none shrink-0 select-none mt-1"
          >
            {heroFlag}
          </div>
        </div>
      </div>

      <!-- Countdown label -->
      <p id="kiosk-cd-label" class="text-sm uppercase tracking-[0.3em] text-zinc-400 mb-5 ml-1">
        Race starts in
      </p>

      <!-- Countdown — digit blocks (days : hrs : min; seconds revive only in the final 10 min) -->
      <div id="kiosk-countdown" class="flex items-stretch gap-1 sm:gap-3 mb-10">
        {(['days','hrs','min'] as const).map((unit, i) => (
          <Fragment>
            <div class="kiosk-digit-block flex flex-col items-center justify-center rounded-xl sm:rounded-2xl px-2 py-2 sm:px-5 sm:py-4 min-w-11 sm:min-w-20">
              <span
                id={`kiosk-cd-${unit}`}
                class="font-mono font-black tabular-nums text-white leading-none block"
                style="font-size: clamp(2rem, 10vw, 7rem);"
              >
                --
              </span>
              <span class="text-sm uppercase tracking-[0.2em] text-zinc-400 mt-1.5">{unit}</span>
            </div>
            {i < 2 && (
              <span
                class="font-mono font-black text-zinc-600 self-center"
                style="font-size: clamp(1.4rem, 4.5vw, 4rem); line-height: 1; margin-top: -0.5rem;"
              >
                :
              </span>
            )}
          </Fragment>
        ))}
        <!-- Seconds — hidden outside the final 10 minutes before live; secondary/smaller styling -->
        <div id="kiosk-cd-sec-group" class="hidden items-stretch gap-1 sm:gap-3">
          <span
            class="font-mono font-black text-zinc-600 self-center"
            style="font-size: clamp(1.4rem, 4.5vw, 4rem); line-height: 1; margin-top: -0.5rem;"
          >
            :
          </span>
          <div class="kiosk-digit-block flex flex-col items-center justify-center self-end rounded-xl sm:rounded-2xl px-1.5 py-1.5 sm:px-3 sm:py-2.5 min-w-8 sm:min-w-[3.25rem]">
            <span
              id="kiosk-cd-sec"
              class="font-mono font-black tabular-nums text-zinc-400 leading-none block"
              style="font-size: clamp(1.1rem, 4.5vw, 3rem);"
            >
              --
            </span>
            <span class="text-sm uppercase tracking-[0.2em] text-zinc-400 mt-1">sec</span>
          </div>
        </div>
      </div>

      <!-- Live mode: next session countdown (secondary to the time-remaining block above) -->
      <p id="kiosk-next-line" hidden class="-mt-6 mb-8 ml-1 text-sm font-medium text-zinc-400 tabular-nums"></p>

      <!-- Rotation indicator -->
      <div id="kiosk-rotation-dots" class="hidden items-center gap-1.5 mb-5 ml-1"></div>

      <!-- Session strip -->
      <div id="kiosk-session-strip-wrap" class={heroSessions.length === 0 ? 'hidden' : ''}>
        <p class="text-sm uppercase tracking-[0.25em] text-zinc-400 mb-2 ml-1">Sessions</p>
        <div id="kiosk-session-strip" class="kiosk-session-strip flex gap-2 overflow-x-auto pb-2">
          {heroSessions.map(session => (
            <div
              class="kiosk-session-pill flex-none flex flex-col gap-1 px-3 py-2.5 rounded-xl border bg-zinc-900/70 border-zinc-800/80 text-zinc-300 min-w-22 backdrop-blur-sm"
              data-session-start={session.startTimeUTC}
              data-session-type={session.type}
            >
              <span class="text-sm font-black uppercase tracking-wider">{SESSION_ABBR[session.type] ?? session.type}</span>
              <time
                data-local-time={session.startTimeUTC}
                data-format="weekday-time"
                class="text-sm tabular-nums font-mono"
              >--</time>
            </div>
          ))}
        </div>
      </div>

      </div><!-- /kiosk-hero-content -->

      <!-- Footer row: refreshed + clock -->
      <div class="pt-6 flex items-end justify-between">
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <span id="kiosk-refreshed" class="text-sm font-mono text-zinc-400">Data as of --:--</span>
          <span id="kiosk-stale" hidden class="text-sm font-mono text-amber-400"></span>
        </div>
        <span id="kiosk-clock" class="text-lg font-mono tabular-nums text-zinc-400 tracking-wide">--:-- ---</span>
      </div>
    </section>

    <!-- ══ Sidebar ══ -->
    <aside
      id="kiosk-sidebar"
      class="flex shrink-0 flex-col min-h-0 max-h-[38%] border-t border-zinc-800/40 landscape:lg:max-h-none landscape:lg:w-96 landscape:lg:border-t-0 landscape:lg:border-l"
    >
      <!-- Sidebar header -->
      <div class="px-6 pt-5 pb-3 landscape:lg:pt-8 landscape:lg:pb-4 border-b border-zinc-800/40">
        <p class="text-sm uppercase tracking-[0.3em] text-zinc-400 font-bold">— Coming Up —</p>
      </div>

      <!-- Event list -->
      <div id="kiosk-sidebar-list" class="flex-1 min-h-0 overflow-y-auto kiosk-noscrollbar px-4 py-4 flex flex-col gap-1.5 portrait:grid portrait:grid-cols-2 portrait:content-start"></div>
    </aside>
  </div>

  <script>
    import { SERIES_META, SERIES_ORDER } from '../lib/series-client';
    import { formatDateRange, isPlaceholderTime } from '../lib/time';
    import { countryFlag, readFavorites } from '../lib/client-utils';
    import { SESSION_ABBR, getSessionEstimatedEndTime, isRaceType, isSessionLiveAt, isSessionPastAt } from '../lib/sessions';
    import {
      createKioskScheduler,
      type KioskScheduler,
    } from '../lib/kiosk/scheduler';
    import { filterKioskEvents, parseKioskConfig } from '../lib/kiosk/config';
    import {
      clearManualSelection,
      createManualSelection,
      getKioskFingerprint,
      getKioskFreshness,
      getKioskMode,
      getKioskRenderMode,
      getKioskShift,
      getKioskTrivia,
      getReadableTextColor,
      getNextKioskSession,
      formatKioskDuration,
      formatKioskRound,
      getNextKioskTransition,
      type KioskEvent,
      type KioskMode,
      type KioskSession as Session,
      type LiveHit,
      type ModeResult,
      resolveKioskEvent,
      rotateLiveResult,
      updateRotationState,
    } from '../lib/kiosk/state';

    // ── Series metadata (imported from series-client.ts) ──
    function getColor(id: string) { return SERIES_META[id]?.color ?? '#71717a'; }
    function getOrder(id: string) { const idx = SERIES_ORDER.indexOf(id); return idx >= 0 ? idx : 99; }
    function getShortLabel(id: string) { return SERIES_META[id]?.shortLabel ?? id; }

    // ── Broadcast info (data/gold/broadcasts.json) ──────────────────────────
    // Kiosk shows one region's channels under the hero event (default NL; ?region=US|UK|NL).
    // ?series=f1,motogp limits the event pool. Both are URL params so a kiosk device can bookmark them.
    type BroadcastEntry = { channel: string; type: string; note?: string };
    type BroadcastsData = { regions: Record<string, unknown>; series: Record<string, Record<string, BroadcastEntry[]>> };
    const broadcastsData: BroadcastsData = JSON.parse(document.getElementById('kiosk-broadcasts')!.textContent ?? '{"regions":{},"series":{}}');

    const kioskConfig = parseKioskConfig(location.search, Object.keys(SERIES_META), Object.keys(broadcastsData.regions));

    function getBroadcastLine(seriesId: string): string | null {
      const entries = broadcastsData.series?.[seriesId]?.[kioskConfig.region];
      if (!entries || entries.length === 0) return null;
      return entries.map(e => e.channel).join(' · ');
    }

    // Season round totals per series (embedded at build time from calendar.json), read once.
    const roundTotals: Record<string, number> = JSON.parse(document.getElementById('kiosk-round-totals')?.textContent ?? '{}');

    // Build-time hint for the empty state (first calendar event not yet finished when the site was built).
    const nextCalendarHint: { eventName: string; dateStart: string; dateEnd: string } | null =
      JSON.parse(document.getElementById('kiosk-next-calendar')?.textContent ?? 'null');

    // ── Constants ────────────────────────────────────────────────────────────
    // ── Auto-rotation ────────────────────────────────────────────────────────
    let rotationEvents: KioskEvent[] = [];
    let rotationIndex = 0;
    // Idle events rotate every 60s, several simultaneous live sessions every 30s (see onRotate).
    const ROTATION_INTERVAL_MS = 30_000;
    let rotationTicks = 0;
    let liveIndex = 0;
    const ROTATION_POOL_SIZE = 5;
    const SIDEBAR_EVENT_COUNT = 8;

    // ── Manual event override ────────────────────────────────────────────────
    let manualEventId: string | null = null;
    let manualExpiresAt: number = 0;

    function setManualEvent(id: string) {
      const nextState = createManualSelection(id);
      manualEventId = nextState.eventId;
      manualExpiresAt = nextState.expiresAt;
      const badge = document.getElementById('kiosk-manual-badge');
      if (badge) badge.style.display = 'flex';
    }

    function clearManualEvent() {
      const nextState = clearManualSelection();
      manualEventId = nextState.eventId;
      manualExpiresAt = nextState.expiresAt;
      const badge = document.getElementById('kiosk-manual-badge');
      if (badge) badge.style.display = 'none';
      updateKioskDisplay(allEvents);
    }

    function resolveEvent(autoResult: ModeResult, events: KioskEvent[]): { event: KioskEvent | null; isManual: boolean } {
      const resolved = resolveKioskEvent(
        autoResult,
        events,
        { events: rotationEvents, index: rotationIndex },
        { eventId: manualEventId, expiresAt: manualExpiresAt },
      );

      manualEventId = resolved.manualState.eventId;
      manualExpiresAt = resolved.manualState.expiresAt;
      const badge = document.getElementById('kiosk-manual-badge');
      if (badge) badge.style.display = 'none';
      if (resolved.isManual) {
        if (badge) badge.style.display = 'flex';
      }
      return { event: resolved.event, isManual: resolved.isManual };
    }

    // ── Countdown ────────────────────────────────────────────────────────────
    // Normal cadence renders D:H:M once a minute; inside the final 10 minutes
    // before an event goes live, seconds reappear and the render loop speeds
    // up to once a second. Either way the displayed value is always computed
    // fresh from Date.now() — never a locally-incrementing counter.
    let cdTargetMs: number | null = null;
    const COUNTDOWN_FINAL_WINDOW_MS = 10 * 60_000;
    const COUNTDOWN_SLOW_MS = 60_000;
    const COUNTDOWN_FAST_MS = 1_000;
    let countdownTimerId: number | null = null;
    let countdownFast = false;

    function pad(n: number) { return String(Math.max(0, n)).padStart(2, '0'); }

    function setSecondsVisible(visible: boolean) {
      const group = document.getElementById('kiosk-cd-sec-group');
      if (group) group.style.display = visible ? 'flex' : 'none';
    }

    // (re)schedules the countdown render loop at the given cadence. No-op if
    // already running at that cadence, so calling this on every render doesn't
    // churn the timer.
    function scheduleCountdownTimer(fast: boolean) {
      if (countdownTimerId !== null && fast === countdownFast) return;
      if (countdownTimerId !== null) { window.clearInterval(countdownTimerId); countdownTimerId = null; }
      countdownFast = fast;
      countdownTimerId = window.setInterval(tickCountdown, fast ? COUNTDOWN_FAST_MS : COUNTDOWN_SLOW_MS);
    }

    // Live mode only: "Next · Race in 2h 05m" under the time-remaining block. Refreshed by the
    // countdown timer (once a minute) — never by the 1s heartbeat.
    let nextTarget: { ms: number; label: string } | null = null;

    function renderNextLine() {
      const el = document.getElementById('kiosk-next-line');
      if (!el) return;
      if (!nextTarget) { el.hidden = true; return; }
      const text = `Next · ${nextTarget.label} in ${formatKioskDuration(nextTarget.ms - Date.now())}`;
      el.hidden = false;
      if (el.textContent !== text) el.textContent = text;
    }

    function tickCountdown() {
      renderNextLine();
      if (cdTargetMs === null) {
        setSecondsVisible(false);
        scheduleCountdownTimer(false);
        return;
      }
      const diff = cdTargetMs - Date.now();
      const totalSec = Math.max(0, Math.floor(diff / 1000));
      const inFinalWindow = diff > 0 && diff <= COUNTDOWN_FINAL_WINDOW_MS;

      setDigit('days', pad(Math.floor(totalSec / 86400)));
      setDigit('hrs', pad(Math.floor((totalSec % 86400) / 3600)));
      setDigit('min', pad(Math.floor((totalSec % 3600) / 60)));
      setSecondsVisible(inFinalWindow);
      if (inFinalWindow) setDigit('sec', pad(totalSec % 60));

      scheduleCountdownTimer(inFinalWindow);
    }

    function stopCountdownTimer() {
      if (countdownTimerId !== null) { window.clearInterval(countdownTimerId); countdownTimerId = null; }
    }

    function setDigit(unit: string, val: string) {
      const el = document.getElementById(`kiosk-cd-${unit}`);
      if (!el || el.textContent === val) return;
      el.textContent = val;
      el.classList.remove('kiosk-cd-tick');
      void (el as HTMLElement).offsetWidth;
      el.classList.add('kiosk-cd-tick');
      setTimeout(() => el.classList.remove('kiosk-cd-tick'), 120);
    }

    // ── Clock ────────────────────────────────────────────────────────────────
    // Corner clock — HH:MM only, updated once a minute (no seconds, no flash).
    let clockTimerId: number | null = null;

    function updateClock() {
      const el = document.getElementById('kiosk-clock');
      if (!el) return;
      const now = new Date();
      const time = now.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', hour12: false });
      const date = now.toLocaleDateString(undefined, { weekday: 'short', day: 'numeric', month: 'short' });
      el.textContent = `${time}  ${date}`;
    }

    function startClockTimer() {
      if (clockTimerId !== null) return;
      updateClock();
      clockTimerId = window.setInterval(updateClock, 60_000);
    }

    function stopClockTimer() {
      if (clockTimerId !== null) { window.clearInterval(clockTimerId); clockTimerId = null; }
    }

    // ── LocalTime hydration ──────────────────────────────────────────────────
    function initLocalTimes() {
      document.querySelectorAll<HTMLTimeElement>('[data-local-time]').forEach(el => {
        const utc = el.dataset.localTime!;
        const fmt = el.dataset.format;
        const d = new Date(utc);
        if (isNaN(d.getTime())) return;
        const opts: Intl.DateTimeFormatOptions = { hour12: false };
        if (fmt === 'datetime' || fmt === 'date') { opts.month = 'short'; opts.day = 'numeric'; }
        if (fmt === 'datetime' || fmt === 'time') { opts.hour = '2-digit'; opts.minute = '2-digit'; }
        if (fmt === 'weekday-time') { opts.weekday = 'short'; opts.hour = '2-digit'; opts.minute = '2-digit'; }
        el.textContent = d.toLocaleString(undefined, opts);
      });
    }

    // ── Rotation dots ────────────────────────────────────────────────────────
    function renderRotationDots(color: string, count: number, index: number) {
      const el = document.getElementById('kiosk-rotation-dots');
      if (!el) return;
      if (count <= 1) {
        el.style.display = 'none';
        return;
      }
      el.style.display = 'flex';
      el.innerHTML = Array.from({ length: count }, (_, i) =>
        `<span style="width:${i === index ? '16px' : '6px'};height:6px;border-radius:9999px;background:${i === index ? color : '#3f3f46'};transition:all 0.3s;"></span>`
      ).join('');
    }

    // ── Hero render ──────────────────────────────────────────────────────────
    let currentMode: KioskMode = 'idle';
    let currentEventId: string | null = null;

    function formatElapsed(startMs: number): string {
      const m = Math.floor((Date.now() - startMs) / 60_000);
      if (m < 1) return 'Just started';
      return `Started ${m} min ago`;
    }

    // The live session currently shown, so the 1s tick can refresh elapsed text + progress bar
    // without re-rendering the hero (which rebuilds the session strip and sidebar).
    let liveSession: Session | null = null;

    function tickLive() {
      if (!liveSession || currentMode !== 'live') return;
      const el = document.getElementById('kiosk-live-elapsed');
      if (el) {
        const text = `${liveSession.type} · ${formatElapsed(new Date(liveSession.startTimeUTC).getTime())}`;
        if (el.textContent !== text) el.textContent = text;
      }
      updateSessionProgressWidth(liveSession);
    }

    function renderHero(event: KioskEvent, mode: KioskMode, liveNow: Session | null, alsoLive: LiveHit[], livePoolSize: number) {
      const color = getColor(event.seriesId);
      const now = Date.now();
      liveSession = mode === 'live' ? liveNow : null;

      // Mode signature animation (jwt3.4): drives which ambient animation
      // is active — see the body[data-kiosk-mode] rules in global.css.
      document.body.dataset.kioskMode = mode;

      // Backgrounds
      const bg1 = document.getElementById('kiosk-hero-bg');
      const bg2 = document.getElementById('kiosk-hero-bg2');
      if (bg1) {
        const opacity = mode === 'live' ? '18' : mode === 'weekend' ? '12' : '0a';
        bg1.style.background = `radial-gradient(ellipse 90% 70% at 35% 55%, ${color}${opacity} 0%, transparent 65%)`;
      }
      if (bg2) bg2.style.background = `radial-gradient(ellipse 50% 40% at 70% 20%, ${color}08 0%, transparent 60%)`;

      // Hero card border
      const heroCard = document.getElementById('kiosk-hero-card');
      if (heroCard) heroCard.style.borderLeft = `3px solid ${color}${mode === 'live' ? 'cc' : mode === 'weekend' ? '90' : '60'}`;

      // Live header
      const liveHeader = document.getElementById('kiosk-live-header');
      if (liveHeader) {
        liveHeader.style.display = mode === 'live' ? 'flex' : 'none';
        // Update dot + ring color
        const dot = liveHeader.querySelector('.kiosk-live-dot') as HTMLElement | null;
        const ring = liveHeader.querySelector('.kiosk-live-ring') as HTMLElement | null;
        if (dot) dot.style.background = color;
        if (ring) ring.style.background = `${color}40`;
      }

      // Also-live chips
      const alsoLiveEl = document.getElementById('kiosk-also-live');
      if (alsoLiveEl) {
        if (mode === 'live' && alsoLive.length > 0) {
          alsoLiveEl.style.display = 'flex';
          alsoLiveEl.innerHTML = `<span class="text-sm text-zinc-400 mr-1 self-center">also live:</span>` +
            alsoLive.map(l => {
              const c = getColor(l.event.seriesId);
              return `<span class="text-sm font-bold px-2 py-0.5 rounded-full text-zinc-100" style="background:${c}30;border:1px solid ${c}90;">${getShortLabel(l.event.seriesId)} · ${SESSION_ABBR[l.session.type] ?? l.session.type} · ${l.event.circuit?.city || l.event.circuit?.name}</span>`;
            }).join('');
        } else {
          alsoLiveEl.style.display = 'none';
        }
      }

      // Event name
      const nameEl = document.getElementById('kiosk-event-name');
      if (nameEl) nameEl.textContent = event.eventName;

      // Circuit
      const circEl = document.getElementById('kiosk-circuit-name');
      if (circEl) {
        const city = event.circuit?.city ? ` · ${event.circuit.city}` : '';
        circEl.textContent = `${event.circuit?.name ?? ''}${city}`;
      }

      // Trivia (hidden when the circuit has no data)
      const triviaEl = document.getElementById('kiosk-trivia');
      if (triviaEl) {
        const trivia = getKioskTrivia(event.circuit);
        triviaEl.textContent = trivia ?? '';
        triviaEl.hidden = !trivia;
      }

      // Flag
      const flagEl = document.getElementById('kiosk-flag');
      if (flagEl) {
        flagEl.textContent = countryFlag(event.circuit?.countryCode ?? '');
        flagEl.style.filter = mode === 'live' ? `drop-shadow(0 0 30px ${color}99)` : '';
      }

      // Series badge (swap via inner HTML)
      const badgeWrap = document.getElementById('kiosk-series-badge');
      if (badgeWrap) {
        const c = color;
        const short = getShortLabel(event.seriesId);
        badgeWrap.innerHTML = `<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-sm font-black" style="background:${c};color:${getReadableTextColor(c)};">${short}</span>`;
      }

      // Round badge
      const roundBadge = document.getElementById('kiosk-round-badge');
      if (roundBadge) {
        roundBadge.textContent = formatKioskRound(event.round, roundTotals[event.seriesId]);
        roundBadge.style.display = mode === 'weekend' ? 'none' : '';
      }
      const weekendBadge = document.getElementById('kiosk-weekend-badge');
      if (weekendBadge) {
        weekendBadge.hidden = mode !== 'weekend';
        weekendBadge.style.background = `${color}40`;
        weekendBadge.style.borderColor = `${color}80`;
      }

      // Countdown
      const cdLabel = document.getElementById('kiosk-cd-label');
      const liveElapsed = document.getElementById('kiosk-live-elapsed');
      const cdEl = document.getElementById('kiosk-countdown');

      if (mode === 'live' && liveSession) {
        // The big block counts down the time REMAINING in the live session (never a dead 00:00:00);
        // the next session's countdown is the smaller secondary line. tickCountdown() drives both.
        cdTargetMs = getSessionEstimatedEndTime(liveSession);
        if (cdLabel) cdLabel.textContent = 'Time remaining';
        const nextSession = getNextKioskSession(event, now);
        nextTarget = nextSession ? { ms: new Date(nextSession.startTimeUTC).getTime(), label: nextSession.type } : null;
        if (liveElapsed) {
          liveElapsed.hidden = false;
        }
        tickLive();
        if (cdEl) (cdEl as HTMLElement).style.setProperty('--cd-glow', `${color}60`);
        // Tint digit blocks in live mode
        document.querySelectorAll<HTMLElement>('.kiosk-digit-block').forEach(b => {
          b.style.borderColor = `${color}30`;
          b.style.boxShadow = `0 0 20px ${color}10, inset 0 0 20px ${color}05`;
        });
      } else {
        if (liveElapsed) liveElapsed.hidden = true;
        nextTarget = null;
        document.querySelectorAll<HTMLElement>('.kiosk-digit-block').forEach(b => {
          b.style.borderColor = '';
          b.style.boxShadow = '';
        });

        let targetSession: Session | null = null;
        if (mode === 'weekend') {
          targetSession = getNextKioskSession(event, now);
          if (!targetSession) {
            targetSession = event.sessions.find(s => !isPlaceholderTime(s.startTimeUTC) && isRaceType(s.type)) ?? null;
          }
        } else {
          targetSession = event.sessions.find(s => !isPlaceholderTime(s.startTimeUTC) && isRaceType(s.type))
            ?? event.sessions.filter(s => !isPlaceholderTime(s.startTimeUTC)).at(-1)
            ?? null;
        }

        if (targetSession) {
          cdTargetMs = new Date(targetSession.startTimeUTC).getTime();
          if (cdLabel) {
            cdLabel.textContent = mode === 'weekend' ? `${targetSession.type} starts in` : 'Race starts in';
          }
        } else {
          cdTargetMs = null;
        }
      }

      // Force an immediate, accurate render + re-arm the countdown loop at the
      // right cadence (fast in the final 10 min, slow otherwise) whenever the
      // hero re-renders — don't wait for the next scheduled tick.
      tickCountdown();

      // Live session progress bar
      renderSessionProgress(mode, liveSession, color);

      // Broadcast info footer
      const broadcastEl = document.getElementById('kiosk-broadcast-info');
      if (broadcastEl) {
        const line = getBroadcastLine(event.seriesId);
        if (line) {
          broadcastEl.textContent = `📺 ${line}`;
          broadcastEl.hidden = false;
        } else {
          broadcastEl.textContent = '';
          broadcastEl.hidden = true;
        }
      }

      // Rotation dots
      if (mode === 'live') renderRotationDots(color, livePoolSize, liveIndex % Math.max(1, livePoolSize));
      else renderRotationDots(color, rotationEvents.length, rotationIndex);

      // Session strip
      renderSessionStrip(event, color, now);
    }

    // ── Empty state ──────────────────────────────────────────────────────────
    // Nothing left to show: swap the hero for a calm "Off-season" panel. The next updateKioskDisplay
    // that finds an event calls renderHero + showHero() again, so no reload is needed to recover.
    function setHeroVisible(visible: boolean) {
      const content = document.getElementById('kiosk-hero-content');
      const empty = document.getElementById('kiosk-empty');
      if (content) content.hidden = !visible;
      if (empty) empty.hidden = visible;
    }

    function renderEmpty() {
      document.body.dataset.kioskMode = 'empty';
      cdTargetMs = null;
      nextTarget = null;
      liveSession = null;
      stopCountdownTimer();
      setHeroVisible(false);
      const nextEl = document.getElementById('kiosk-empty-next');
      if (nextEl) {
        const todayIso = new Date().toISOString().slice(0, 10);
        nextEl.textContent = nextCalendarHint && nextCalendarHint.dateEnd >= todayIso
          ? `Next event: ${nextCalendarHint.eventName} · ${formatDateRange(nextCalendarHint.dateStart, nextCalendarHint.dateEnd)}`
          : '';
      }
    }

    function renderSessionProgress(mode: KioskMode, liveSession: Session | null, color: string) {
      const wrap = document.getElementById('kiosk-session-progress-wrap');
      const bar = document.getElementById('kiosk-session-progress-bar');
      if (!wrap || !bar) return;

      if (mode !== 'live' || !liveSession) {
        wrap.classList.add('hidden');
        return;
      }

      wrap.classList.remove('hidden');
      (bar as HTMLElement).style.background = color;
      updateSessionProgressWidth(liveSession);
    }

    function updateSessionProgressWidth(session: Session) {
      const bar = document.getElementById('kiosk-session-progress-bar');
      if (!bar) return;
      const startMs = new Date(session.startTimeUTC).getTime();
      const totalMs = getSessionEstimatedEndTime(session) - startMs;
      const pct = totalMs > 0 ? Math.min(100, Math.max(0, ((Date.now() - startMs) / totalMs) * 100)) : 0;
      const width = `${pct.toFixed(1)}%`;
      if ((bar as HTMLElement).style.width !== width) (bar as HTMLElement).style.width = width;
    }

    let stripEventId: string | null = null;

    function renderSessionStrip(event: KioskEvent, color: string, now: number) {
      const strip = document.getElementById('kiosk-session-strip');
      const wrap = document.getElementById('kiosk-session-strip-wrap');
      if (!strip) return;

      const validSessions = event.sessions.filter(s => !isPlaceholderTime(s.startTimeUTC));
      if (validSessions.length === 0) { if (wrap) wrap.classList.add('hidden'); return; }
      if (wrap) wrap.classList.remove('hidden');

      // Find the soonest future session index
      const futureTimes = validSessions.map(s => new Date(s.startTimeUTC).getTime()).filter(t => t > now);
      const nextStart = futureTimes.length > 0 ? Math.min(...futureTimes) : null;

      // The 30s refresh re-renders the same event: keep the user's horizontal scroll (reset on a new event).
      const scrollLeft = stripEventId === event.id ? strip.scrollLeft : 0;
      stripEventId = event.id;
      strip.innerHTML = validSessions.map(s => {
        const startMs = new Date(s.startTimeUTC).getTime();
        // Same definitions as the main page (no grace) — see lib/sessions.ts.
        const isLive = isSessionLiveAt(s, now);
        const isPast = isSessionPastAt(s, now);
        const isNext = !isPast && !isLive && startMs === nextStart;

        let classes = 'kiosk-session-pill flex-none flex flex-col gap-1 px-3 py-2.5 rounded-xl border min-w-22 backdrop-blur-sm';
        let inlineStyle = '';

        if (isPast) {
          classes += ' bg-zinc-900/40 border-zinc-800/50 text-zinc-400';
          inlineStyle = 'text-decoration: line-through;';
        } else if (isLive) {
          classes += ' bg-zinc-900/80 text-white border-transparent';
          inlineStyle = `border-left: 3px solid ${color}; box-shadow: 0 0 12px ${color}20;`;
        } else if (isNext) {
          classes += ' bg-zinc-900/80 text-zinc-200 border-transparent';
          inlineStyle = `border-left: 2px solid ${color}90;`;
        } else {
          classes += ' bg-zinc-900/50 border-zinc-800/60 text-zinc-300';
        }

        return `
          <div class="${classes}" data-session-start="${s.startTimeUTC}" data-session-type="${s.type}" style="${inlineStyle}">
            <span class="text-sm font-black uppercase tracking-wider">${SESSION_ABBR[s.type] ?? s.type}</span>
            <time data-local-time="${s.startTimeUTC}" data-format="weekday-time" class="text-sm tabular-nums font-mono">--</time>
          </div>`;
      }).join('');
      strip.scrollLeft = scrollLeft;

      initLocalTimes();
    }

    // ── Sidebar ──────────────────────────────────────────────────────────────
    function renderSidebar(events: KioskEvent[], heroId: string | null) {
      const listEl = document.getElementById('kiosk-sidebar-list');
      if (!listEl) return;
      const now = Date.now();
      const upcoming = events
        .filter(e => e.id !== heroId && e.sessions.some(s => !isPlaceholderTime(s.startTimeUTC) && new Date(s.startTimeUTC).getTime() > now))
        .slice(0, SIDEBAR_EVENT_COUNT);

      const scrollTop = listEl.scrollTop;
      listEl.innerHTML = upcoming.map(event => {
        const color = getColor(event.seriesId);
        const short = getShortLabel(event.seriesId);
        const flag = countryFlag(event.circuit?.countryCode ?? '');
        // dateStart/dateEnd are circuit-local dates: same helper as the SSR markup (parses at noon UTC).
        const dateStr = formatDateRange(event.dateStart, event.dateEnd);
        const isActive = event.id === manualEventId;
        return `
          <button class="kiosk-sidebar-event${isActive ? ' kiosk-sidebar-active' : ''} w-full text-left flex items-center gap-3 px-3 py-3 rounded-xl border ${isActive ? 'border-zinc-600/50 bg-zinc-900/80' : 'border-transparent hover:border-zinc-700/40 hover:bg-zinc-900/60'}" data-event-id="${event.id}">
            <span class="shrink-0 text-sm font-black px-1.5 py-0.5 rounded leading-tight" style="background:${color};color:${getReadableTextColor(color)};">${short}</span>
            <div class="min-w-0 flex-1">
              <p class="text-base font-semibold leading-tight truncate text-zinc-200">${event.eventName}</p>
              <p class="text-sm text-zinc-400 mt-0.5 truncate">${event.circuit?.name ?? ''}${flag ? ' · ' + flag : ''}</p>
            </div>
            <span class="shrink-0 text-sm text-zinc-400 font-mono">${dateStr}</span>
          </button>`;
      }).join('');
      listEl.scrollTop = scrollTop;

      // Re-attach click handlers
      listEl.querySelectorAll<HTMLButtonElement>('.kiosk-sidebar-event').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.eventId;
          if (!id) return;
          if (manualEventId === id) {
            clearManualEvent();
          } else {
            setManualEvent(id);
            updateKioskDisplay(allEvents);
          }
        });
      });
    }

    // ── Main display update ──────────────────────────────────────────────────
    // Next instant a session starts/ends; the 1s heartbeat re-renders once the clock passes it.
    let nextTransitionMs: number | null = null;

    // Live hits (favorites first) with the hero rotated to the current liveIndex.
    function getAutoResult(events: KioskEvent[], now: number): ModeResult {
      return rotateLiveResult(getKioskMode(events, now, getOrder, new Set(readFavorites())), liveIndex);
    }

    function updateKioskDisplay(events: KioskEvent[]) {
      const now = Date.now();
      nextTransitionMs = getNextKioskTransition(events, now);
      const autoResult = getAutoResult(events, now);
      // A live session just ended: restart rotation at the soonest event instead of
      // resuming wherever the rotation index was parked before the session went live.
      if (currentMode === 'live' && autoResult.mode !== 'live') { rotationIndex = 0; liveIndex = 0; }
      // Refresh rotation pool when not in live or manual mode
      if (autoResult.mode !== 'live' && !(manualEventId && now < manualExpiresAt)) {
        const rotationState = updateRotationState(
          { events: rotationEvents, index: rotationIndex },
          events,
          now,
          ROTATION_POOL_SIZE,
        );
        rotationEvents = rotationState.events;
        rotationIndex = rotationState.index;
      }
      const { event: resolvedEvent, isManual } = resolveEvent(autoResult, events);
      const event = resolvedEvent;
      // Derived from the event actually shown (rotation/manual can pick one weeks away), not the next event.
      const mode: KioskMode = getKioskRenderMode(autoResult, event, isManual, now);

      if (!event) {
        currentMode = 'empty';
        currentEventId = null;
        renderEmpty();
        const sidebarEl = document.getElementById('kiosk-sidebar');
        if (sidebarEl) sidebarEl.style.display = 'none';
        return;
      }
      setHeroVisible(true);

      const modeChanged = mode !== currentMode || event.id !== currentEventId;
      currentMode = mode;
      currentEventId = event.id;

      renderHero(event, mode, autoResult.session, autoResult.alsoLive, autoResult.livePoolSize);

      // Sidebar visibility
      const sidebar = document.getElementById('kiosk-sidebar');
      if (sidebar) sidebar.style.display = (mode === 'live' && !isManual) ? 'none' : '';

      renderSidebar(events, event.id);

      // Mode transition
      if (modeChanged) {
        const root = document.getElementById('kiosk-root');
        if (root) {
          root.classList.remove('kiosk-mode-enter');
          void root.offsetWidth;
          root.classList.add('kiosk-mode-enter');
        }
      }
    }

    // ── Always-on hygiene (jwt3.15) ──────────────────────────────────────────
    // Wake Lock: released by the browser whenever the tab is hidden, so re-request on every wake().
    let wakeLock: WakeLockSentinel | null = null;
    async function requestWakeLock() {
      try {
        if (!wakeLock || wakeLock.released) wakeLock = (await navigator.wakeLock?.request('screen')) ?? null;
      } catch { /* unsupported, or refused (battery saver / no user gesture): the screen may sleep, nothing else breaks */ }
    }

    // Burn-in: nudge the whole layout a few px every 5 min (getKioskShift is clock-derived, so the
    // 30s mode refresh is enough to apply it). Uses the `translate` property, which coexists with
    // the mode-enter animation's `transform`.
    function applyBurnInShift() {
      const { x, y } = getKioskShift(Date.now());
      const root = document.getElementById('kiosk-root');
      if (root) root.style.translate = `${x}px ${y}px`;
    }

    // Hide the cursor + Back button after 10s without input; any input brings them back.
    let chromeTimer: number | undefined;
    function armChromeHide() {
      document.body.classList.remove('kiosk-idle');
      window.clearTimeout(chromeTimer);
      chromeTimer = window.setTimeout(() => document.body.classList.add('kiosk-idle'), 10_000);
    }
    for (const type of ['pointermove', 'pointerdown', 'keydown']) window.addEventListener(type, armChromeHide, { passive: true });

    // ── Refresh ──────────────────────────────────────────────────────────────
    let allEvents: KioskEvent[] = filterKioskEvents<KioskEvent>(JSON.parse(document.getElementById('kiosk-data')!.textContent ?? '[]'), kioskConfig.series);
    let cachedFingerprint: string | null = null;
    let kioskScheduler: KioskScheduler | null = null;

    // Freshness: `generated` is when the pipeline built the feed; lastOkAt is our last good fetch.
    let dataGenerated: string | null = JSON.parse(document.getElementById('kiosk-generated')?.textContent ?? 'null');
    let lastOkAt = Date.now();
    let consecutiveFailures = 0;
    let refreshInFlight = false;

    function clockTime(ms: number) {
      return new Date(ms).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', hour12: false });
    }

    function renderFreshness() {
      const el = document.getElementById('kiosk-refreshed');
      if (el) {
        const g = dataGenerated ? new Date(dataGenerated) : null;
        el.textContent = g && !isNaN(g.getTime())
          ? `Data as of ${g.toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false })}`
          : `Updated ${clockTime(lastOkAt)}`;
      }
      const stale = document.getElementById('kiosk-stale');
      if (stale) {
        const state = getKioskFreshness(dataGenerated, Date.now(), consecutiveFailures);
        stale.hidden = state === 'fresh';
        stale.textContent = state === 'offline'
          ? `Offline? Data may be stale (last ok ${clockTime(lastOkAt)})`
          : state === 'old' ? 'Data may be stale (feed is over 36h old)' : '';
      }
    }

    async function refreshData() {
      if (refreshInFlight) return;
      refreshInFlight = true;
      try {
        const base = JSON.parse(document.getElementById('kiosk-base')!.textContent ?? '""');
        const res = await fetch(`${base}/data/gold/upcoming.json`, { cache: 'no-store' });
        if (!res.ok) throw new Error(`upcoming.json ${res.status}`);
        const envelope = await res.json();
        const data: KioskEvent[] = envelope.events ?? envelope;
        const fp = getKioskFingerprint(envelope);
        if (cachedFingerprint && fp !== cachedFingerprint) { location.reload(); return; }
        cachedFingerprint = fp;
        consecutiveFailures = 0;
        lastOkAt = Date.now();
        dataGenerated = envelope.generated ?? dataGenerated;
        allEvents = filterKioskEvents(data, kioskConfig.series).sort((a, b) => a.dateStart.localeCompare(b.dateStart));
        updateKioskDisplay(allEvents); // already re-renders the sidebar
      } catch {
        consecutiveFailures++;
      } finally {
        refreshInFlight = false;
        renderFreshness();
      }
    }

    // After a display sleep / throttled background tab / network return: fix the view NOW
    // (timers may have been frozen for hours) and then check for fresh data.
    function wake() {
      if (document.visibilityState === 'hidden') return;
      updateKioskDisplay(allEvents);
      tickCountdown();
      updateClock();
      renderFreshness();
      applyBurnInShift();
      void requestWakeLock();
      void refreshData();
    }
    document.addEventListener('visibilitychange', wake);
    window.addEventListener('online', wake);
    window.addEventListener('pageshow', (e) => { if (e.persisted) wake(); });

    // ── Boot ─────────────────────────────────────────────────────────────────
    function init() {
      kioskScheduler?.stop();
      stopClockTimer();
      stopCountdownTimer();
      initLocalTimes();
      updateKioskDisplay(allEvents); // also arms the countdown loop via tickCountdown()
      applyBurnInShift();
      void requestWakeLock();
      armChromeHide();
      cachedFingerprint = getKioskFingerprint({ generated: dataGenerated ?? undefined, events: allEvents });
      renderFreshness();

      // Manual badge click
      document.getElementById('kiosk-manual-badge')?.addEventListener('click', clearManualEvent);

      kioskScheduler = createKioskScheduler({
        rotationIntervalMs: ROTATION_INTERVAL_MS,
        onSecondTick: () => {
          // Countdown + clock run on their own timers — see scheduleCountdownTimer() /
          // startClockTimer(). This 1s heartbeat only (a) does a full re-render at the
          // moment any session starts/ends (nextTransitionMs) or a manual pick expires,
          // and (b) otherwise just refreshes the live elapsed text + progress bar —
          // it must not touch the session strip / sidebar DOM (that resets their scroll).
          const t = Date.now();
          if ((nextTransitionMs !== null && t >= nextTransitionMs) || (manualEventId && t >= manualExpiresAt)) {
            updateKioskDisplay(allEvents);
          } else {
            tickLive();
          }
        },
        onModeRefresh: () => { updateKioskDisplay(allEvents); renderFreshness(); applyBurnInShift(); },
        onRotate: () => {
          if (manualEventId && Date.now() < manualExpiresAt) return;
          rotationTicks++;
          const autoResult = getKioskMode(allEvents, Date.now(), getOrder, new Set(readFavorites()));
          if (autoResult.mode === 'live') {
            if (autoResult.livePoolSize > 1) { liveIndex = (liveIndex + 1) % autoResult.livePoolSize; updateKioskDisplay(allEvents); }
            return;
          }
          if (rotationTicks % 2 !== 0) return; // idle pool keeps its 60s cadence
          if (rotationEvents.length > 1) {
            rotationIndex = (rotationIndex + 1) % rotationEvents.length;
            updateKioskDisplay(allEvents);
          }
        },
        onDataRefresh: refreshData,
      });
      kioskScheduler.start();

      startClockTimer();
    }

    init();
    document.addEventListener('astro:before-swap', () => {
      kioskScheduler?.stop();
      stopClockTimer();
      stopCountdownTimer();
    });
    document.addEventListener('astro:after-swap', init);
  </script>
</Layout>
